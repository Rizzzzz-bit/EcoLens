# ── Database ──────────────────────────────────────────────────────────────────
# Local dev example (Docker Compose):
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/ecolens
# Render example (auto-injected by render.yaml):
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-secret-key   # e.g. openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads

# ── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here   # https://aistudio.google.com/app/apikey

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production example:
# ALLOWED_ORIGINS=https://your-app.vercel.app
